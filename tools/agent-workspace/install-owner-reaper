#!/usr/bin/env bash
set -euo pipefail
component=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# This only installs the user timer. Component selection remains the normal tools deployment.
command -v node >/dev/null
node "$component/main" reap-ended-owners --help >/dev/null
config="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
mkdir -p "$config"
for name in agent-workspace-owner-liveness.service agent-workspace-owner-liveness.timer; do
  install -m 0644 "$component/$name" "$config/$name"
done
systemctl --user daemon-reload
systemctl --user enable --now agent-workspace-owner-liveness.timer
