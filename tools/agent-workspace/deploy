#!/usr/bin/env bash
set -euo pipefail
if (( EUID != 0 )) && [[ ${PI_STACK_DEPLOY_NO_SUDO:-0} != 1 ]]; then
  exec sudo -n --preserve-env=PI_STACK_TOOLS_DEST,PI_STACK_RELEASES_ROOT,PI_STACK_HOST_LOCK_PATH,PI_STACK_DEPLOY_TIMEOUT_SECONDS,PI_STACK_PUBLICATION_REQUEST,PI_STACK_COMPONENT_SOURCE_REPO bash "$(realpath "$0")" "$@"
fi
root=$(cd "$(dirname "$0")/../.." && pwd)
source "$root/deploy/lib"
pi_stack_enter_deployment "$0" "$root" "$@"
(( $# == 0 )) || { echo 'usage: tools/agent-workspace/deploy' >&2; exit 64; }
dest=${PI_STACK_TOOLS_DEST:-/srv/pi/tools}
commit=$(git -C "$root" rev-parse HEAD)
[[ -L $dest && -f $dest/.pi-stack-commit ]] || {
  echo 'component deployment requires an existing managed tools release' >&2; exit 66;
}
baseline=$(<"$dest/.pi-stack-commit")
comparison=$baseline
if git -C "$root" cat-file -e "$baseline^{commit}" 2>/dev/null; then
  git -C "$root" merge-base --is-ancestor "$baseline" "$commit" || {
    echo "candidate must descend from selected tools source $baseline; integrate explicit component fixes with node $dest/agent-workspace/source-lineage.mjs integrate ADMITTED_CHECKOUT $dest FIX_COMMIT" >&2; exit 65;
  }
elif comparison=$(node "$root/tools/agent-workspace/installed-base.mjs" "$root" "$dest"); then
  # The selected source object is unavailable, but an ancestor's component tree equals the installed bytes.
  echo "selected tools source $baseline is not in this repository; installed agent-workspace equals ancestor $comparison" >&2
else
  comparison=$(node -e 'const fs=require("node:fs"); console.log(JSON.parse(fs.readFileSync(process.argv[1],"utf8")).recoveredGitCommit)' "$root/tools/agent-workspace/recovered-custody.json")
  node "$root/tools/agent-workspace/recovered-base.mjs" "$root" "$dest" "$comparison" "$baseline" || exit 65
fi
git -C "$root" diff --quiet "$comparison" "$commit" -- tools ':!tools/agent-workspace' ':!tools/host-retention' ':!tools/README.md' config/tools.json || {
  echo 'component deployment refuses changes to other tools or their manifest; use the full release owner' >&2; exit 65;
}
# Keep complete ancestry in durable local custody before publishing its identity.
# The source repository is retained outside disposable admitted workspaces.
custody=${PI_STACK_COMPONENT_SOURCE_REPO:-$(dirname "$(readlink -f "$dest")")/../../component-source.git}
custody=$(realpath -m "$custody")
node "$root/tools/agent-workspace/source-lineage.mjs" retain "$root" "$custody" "$commit" >/dev/null
stage=$(mktemp -d "${TMPDIR:-/tmp}/pi-workspace-tools.XXXXXXXX")
trap 'rm -rf "$stage"' EXIT
rsync -a "$(readlink -f "$dest")/" "$stage/"
rm -rf "$stage/agent-workspace"
# This recovered historical marker was superseded by the immutable component receipt.
rm -f "$stage/.agent-workspace-component.json"
rsync -a --chmod=D755 --exclude=deploy "$root/tools/agent-workspace/" "$stage/agent-workspace/"
node "$stage/agent-workspace/main" --help >/dev/null
printf '%s\n' "$commit" > "$stage/.pi-stack-commit"
# Household operators (the kenan-operators group; a host without it has none) run root
# read-only observations through operator-observe.mjs at the stable selected path.
observer_node=$(command -v node)
observer_entry=$dest/agent-workspace/operator-observe.mjs
observer_gid=$(getent group kenan-operators | cut -d: -f3) || observer_gid=
node - "$stage/agent-workspace/.component-release.json" "$baseline" "$commit" "$observer_node" "$observer_entry" "$observer_gid" "$custody" <<'NODE'
const fs = require('node:fs');
const [file, baseline, sourceCommit, node, entry, gid, sourceRepository] = process.argv.slice(2);
fs.writeFileSync(file, JSON.stringify({component: 'agent-workspace', baseline, sourceCommit, sourceRepository, deployedAt: Date.now(),
  scope: 'tools-only; other tool bodies and dependency links retained',
  ...(gid === '' ? {} : {operatorObserver: {gid: Number(gid), node, entry}})}, null, 2) + '\n');
NODE
pi_stack_publish_release "$root" "$stage" "$dest" tools
cmp "$root/tools/agent-workspace/workspace.mjs" "$dest/agent-workspace/workspace.mjs"
node "$dest/agent-workspace/main" --help >/dev/null
printf 'deployed agent-workspace %s over tools %s; no services or workspace records changed\n' "$commit" "$baseline"

# The operator group may run the observer as root; without the group the rule is absent.
if (( EUID == 0 )); then
  observer_rule=/etc/sudoers.d/agent-workspace-operator-observe
  if [[ -n $observer_gid ]]; then
    rule=$(mktemp)
    printf '# Installed by pi-stack tools/agent-workspace/deploy: root read-only observations of paths the caller owns.\n%%kenan-operators ALL=(root) NOPASSWD: %s %s *\n' "$observer_node" "$observer_entry" > "$rule"
    visudo -cqf "$rule"
    install -m 0440 -o root -g root "$rule" "$observer_rule"
    rm -f "$rule"
  else
    rm -f "$observer_rule"
  fi
fi

# Shared Git writers use one kernel-held object-store fence on this host.
if [[ $dest == /srv/pi/tools ]]; then
  pi_stack_as_root bash "$root/tools/agent-workspace/install-serialized-git"
fi
