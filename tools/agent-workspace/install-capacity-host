#!/bin/bash
# Converge-only narrow tools installation; no Kenan runtime publication.
set -euo pipefail
repo=$1; base=$2; expected=$3; receipt=$4
# Wait for rollback fixture capacity before taking either publication fence.
# The slot parent survives until the complete installer exits; sudo passes only
# this resource hint, not an execution or authorization grant.
if [[ ${5:-} != locked && ${5:-} != test-slot-held ]]; then
 exec /usr/local/bin/node "$(dirname "$0")/install-test-slot.mjs" "$0" "$@"
fi
# The outer installer may be invoked with sudo. Preserve the invoking operator's
# command discovery rather than silently writing /root or failing after mutation.
operator_home=$HOME
if (( EUID == 0 )) && [[ ${5:-} != locked ]]; then
 [[ ${SUDO_USER:-} && $SUDO_USER != root ]] || { echo 'outer installer requires an invoking operator (run without sudo)' >&2; exit 64; }
 operator_home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
 [[ -d $operator_home/.local/bin ]] || { echo 'invoking operator command directory missing' >&2; exit 64; }
fi
if [[ ${5:-} != locked ]]; then
 # Install stable discovery from this committed source before fencing. All future
 # CLI calls share admission; detached originals are drained below, never killed.
 sudo install -Dm755 "$repo/tools/agent-workspace/admission-launcher" /usr/local/libexec/agent-workspace-admission
 sudo touch /run/lock/agent-workspace-admission.lock /run/lock/agent-workspace-admission.lock.turnstile
 sudo chmod 0666 /run/lock/agent-workspace-admission.lock /run/lock/agent-workspace-admission.lock.turnstile
 sudo ln -sfn /usr/local/libexec/agent-workspace-admission /usr/local/bin/agent-workspace
 ln -sfn /usr/local/libexec/agent-workspace-admission "$operator_home/.local/bin/agent-workspace"
 sudo install -m644 "$repo/tools/agent-workspace/admission-tmpfiles.conf" /etc/tmpfiles.d/agent-workspace.conf
 # The installed sampler has a 240-second execution budget. Admission waiting
 # must outlast a legitimate shared holder; the separate drain stays bounded.
 if sudo env AGENT_WORKSPACE_TEST_SLOT_HELD="$AGENT_WORKSPACE_TEST_SLOT_HELD" flock --exclusive --nonblock --conflict-exit-code 75 /srv/pi/.pi-stack-deploy.lock flock --exclusive --wait 30 --conflict-exit-code 75 /run/lock/agent-workspace-admission.lock.turnstile timeout 400 flock --exclusive --wait 300 --conflict-exit-code 75 /run/lock/agent-workspace-admission.lock /bin/bash "$0" "$repo" "$base" "$expected" "$receipt" locked; then
  exit 0
 else
  status=$?
  if (( status == 75 )); then
   printf '%s\n' '{"ok":false,"error":{"code":"host-tool-install-lock-busy","detail":"Host publication or workspace admission is occupied; no selection made by this attempt. Preserve current holder; resume after its terminal/cgroup-empty receipt.","locks":["/srv/pi/.pi-stack-deploy.lock","/run/lock/agent-workspace-admission.lock"]}}' >&2
  else
   printf '{"ok":false,"error":{"code":"host-tool-install-failed","exitCode":%d,"detail":"Reconcile selection and receipt before retry; this is not success."}}\n' "$status" >&2
  fi
  exit "$status"
 fi
fi
# Stable launchers already fence new admissions. Existing detached originals finish
# naturally; no PID or systemd unit is killed and no ledger data is changed.
python3 - "$receipt" <<'PY'
import os,time,json,sys
start=time.time(); empty=0
while time.time()-start<80:
 active=[]
 for p in os.listdir('/proc'):
  if not p.isdigit():continue
  try:a=open('/proc/'+p+'/cmdline','rb').read().decode().split('\0')
  except (OSError,UnicodeError):continue
  if any(x.endswith(('/agent-workspace/workspace.mjs','/agent-workspace/source-job.mjs','/agent-workspace/checkout-job.mjs')) for x in a):active.append(int(p))
 if not active:empty+=1
 else:empty=0
 if empty==2:
  json.dump({'originalMutableProcesses':active,'twoConsecutiveEmptyScans':True,'waitSeconds':time.time()-start,'noKills':True},open(sys.argv[1]+'.drain.json','w'));break
 time.sleep(1)
else:raise SystemExit('original mutable helpers still active; no effects applied')
PY
/usr/local/bin/node "$repo/tools/agent-workspace/capacity-deploy.mjs" "$repo" "$base" "$expected" "$receipt" reservation-aware
