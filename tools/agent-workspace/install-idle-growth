#!/usr/bin/env bash
set -euo pipefail
component=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
node "$component/main" retire-idle-growth --help >/dev/null
config="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
mkdir -p "$config" "$HOME/.local/libexec"
# The selected source owns the executable body; the launcher supplies the established
# same-UID read capability without changing checkout ownership or permissions.
install -m 0755 "$component/idle-growth-run" "$HOME/.local/libexec/agent-workspace-idle-growth"
for name in agent-workspace-idle-growth.service agent-workspace-idle-growth.timer; do
  install -m 0644 "$component/$name" "$config/$name"
done
systemctl --user daemon-reload
systemctl --user enable --now agent-workspace-idle-growth.timer
