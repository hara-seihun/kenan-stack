#!/usr/bin/env python3
"""Compose or send owned Proton Bridge mail with local, durable SMTP receipts.

Draft is the default. --send sends once per --request-id. Reuse that identity to
inspect/retry a known pre-DATA failure; unknown outcomes require investigation.
"""
import argparse
import base64
import email.utils
import fcntl
import hashlib
import imaplib
import json
import mimetypes
