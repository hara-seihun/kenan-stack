# Kenan Stack spawns tools with socket stdio, which cannot be reopened through /dev/stdin; read it once instead.
BODY_CACHE = {}


def valid_name(name):
    return isinstance(name, str) and bool(name.strip()) and '\n' not in name and '\r' not in name


def stdin_envelope():
    """The mail tool's stdin: {"body": TEXT, "inheritWriters": [WRITER_ID], "senderNames": {ADDRESS: NAME}}: the writers whose
    threads this send may take over, and the configured From display name of each sender address (base address, lower case)."""
    if 'envelope' not in BODY_CACHE:
        value = json.loads(sys.stdin.read())
        if (not isinstance(value, dict) or set(value) != {'body', 'inheritWriters', 'senderNames'} or not isinstance(value['body'], str)
                or not isinstance(value['inheritWriters'], list) or any(not isinstance(w, str) or not w.strip() for w in value['inheritWriters'])
                or not isinstance(value['senderNames'], dict)
                or any(address != base_address(address) or '@' not in address or not valid_name(name) for address, name in value['senderNames'].items())):
            raise ValueError('--stdin-envelope needs {"body": string, "inheritWriters": [string], "senderNames": {"address": "single-line name"}}')
        BODY_CACHE['envelope'] = value
    return BODY_CACHE['envelope']


def read_body(args):
    if args.stdin_envelope:
        return stdin_envelope()['body']
    path = args.body_file
    if path not in BODY_CACHE:
        BODY_CACHE[path] = sys.stdin.read() if path in ('-', '/dev/stdin') else Path(path).read_text(encoding='utf-8')
    return BODY_CACHE[path]


def sender_name(args, sender):
    """The From display name: --from-name for this send, else the name configured for the sender's base address; never a stand-in."""
    if args.from_name is not None:
        if not valid_name(args.from_name):
            raise SenderError('sender-name-invalid', 'The From display name must be one nonempty line')
        return args.from_name
    names = stdin_envelope()['senderNames'] if args.stdin_envelope else {}
    name = names.get(base_address(sender))
    if name is None:
        raise SenderError('sender-name-unconfigured', f'No display name is configured for {base_address(sender)}: add it to tools.mail.senders in the person\'s mail config (/etc/kenan/domains/PERSON.json), or name it for this send (mail tool fromName, CLI --from-name)')
    return name


def inherit_writers(args):
    return frozenset(stdin_envelope()['inheritWriters']) if args.stdin_envelope else frozenset()


class SenderError(Exception):
    def __init__(self, code, message):
        self.code = code
        super().__init__(f'{code}: {message}')


def parent_headers(folder, number, account):
    connection = account.imap_connection()
    try:
        # The folder "*" (or one whose UIDVALIDITY isn't the reference's) is found from the reference's UIDVALIDITY.
        [(folder, [number])] = locate(connection, folder, [number])
        status, _ = connection.select(quote_box(folder), readonly=True)
        if status != 'OK':
            raise ValueError('Cannot select reply folder')
        content = fetch_message(connection, number, uidvalidity(connection),
                                'BODY.PEEK[HEADER.FIELDS (MESSAGE-ID REFERENCES SUBJECT FROM REPLY-TO TO CC BCC DELIVERED-TO X-ORIGINAL-TO)]')
        header = email.message_from_bytes(content)
        one = lambda value: ' '.join(str(value or '').split())  # headers arrive folded over lines
        if not one(header.get('Message-ID')):
            raise ValueError('Parent message has no Message-ID; cannot thread a reply')
        many = lambda name: [one(v) for v in header.get_all(name, [])]
        return {'messageId': one(header.get('Message-ID')),
                'references': one(header.get('References')).split(),
                'subject': one(make_header(decode_header(header.get('Subject') or ''))),
                'from': one(header.get('From')),
                'replyTo': one(header.get('Reply-To')),
                'to': many('To'),
                'cc': many('Cc'),
                'bcc': many('Bcc'),
                'delivered': many('Delivered-To') + many('X-Original-To')}
    finally:
        try:
            connection.logout()
        except Exception:
            pass


def plain_addresses(values):
    return [address.lower() for _, address in email.utils.getaddresses(values) if '@' in address]


def choose_sender(explicit, parent, owned):
    """The From address: explicit, else the address of ours the replied-to message reached; never an account default."""
    if explicit:
        try:
            address = addresses([explicit])
        except ValueError:
            address = []
        if len(address) != 1:
            raise SenderError('sender-invalid', 'From needs exactly one email address')
        if not owned(address[0]):
            raise SenderError('sender-not-owned', f'{address[0]} is not an address this mailbox can send as')
        return address[0], 'explicit'
    if parent is None:
        raise SenderError('sender-required', 'A new message needs an explicit From (--from-addr): one of the addresses this mailbox owns')
    for basis, values in (('delivered-to', parent['delivered']), ('own-message', [parent['from']]), ('recipient', parent['to'] + parent['cc'])):
        found = sorted({address for address in plain_addresses(values) if owned(address)})
        if len(found) == 1:
            return found[0], basis
        if found:
            raise SenderError('sender-ambiguous', f'The replied-to message reached several of our addresses ({", ".join(found)}); pass an explicit From')
    raise SenderError('sender-required', 'The replied-to message was not addressed to any address this account owns; pass an explicit From (--from-addr)')


def reply_recipients(parent, owned):
    """Who a reply goes to when no To is given: our own message's recipients, else its Reply-To or From.
    Decided by who wrote the parent, not by how the sender was chosen (2026-10-30: an explicit From on a reply
    to our own sent mail sent the reply back to ourselves). Our own message's recipients are its To, else its Cc,
    else its Bcc: Proton files a Sent copy whose To it could not match to the envelope under Bcc (2026-10-31)."""
    if any(owned(address) for address in plain_addresses([parent['from']])):
        for field in ('to', 'cc', 'bcc'):
            if plain_addresses(parent[field]):
                return parent[field]
        raise ValueError('The replied-to message is ours and names no recipients; pass To explicitly')
    return [parent['replyTo'] or parent['from']]


def header_addresses(values):
    """A To/Cc header naming exactly the envelope's addresses (lower case), display names kept. Proton Bridge files any
    envelope recipient it can't find verbatim in To/Cc as Bcc (2026-10-31: To "Morgan.s…", envelope "Morgan.s…": the
    Sent copy had an empty To and a reply to it had no recipient)."""
    return ', '.join(email.utils.formataddr((name, address.lower())) for name, address in email.utils.getaddresses(values))


def addresses(values):
    result = [address.lower() for _, address in email.utils.getaddresses(values)]
    if not result or any('@' not in address or any(c.isspace() or c in '<>\r\n' for c in address) for address in result):
        raise ValueError('Recipients need explicit email addresses')
    return sorted(set(result))


# These signatures identify a format, not whether a document/image is valid or safe to open.
ATTACHMENT_FORMATS = (
    ('image/jpeg', '.jpg', lambda b: b.startswith(b'\xff\xd8\xff')),
    ('image/png', '.png', lambda b: b.startswith(b'\x89PNG\r\n\x1a\n')),
    ('image/gif', '.gif', lambda b: b[:6] in (b'GIF87a', b'GIF89a')),
    ('image/webp', '.webp', lambda b: b[:4] == b'RIFF' and b[8:12] == b'WEBP'),
    ('image/bmp', '.bmp', lambda b: b.startswith(b'BM')),
    ('image/tiff', '.tif', lambda b: b[:4] in (b'II\x2a\x00', b'MM\x00\x2a', b'II\x2b\x00', b'MM\x00\x2b')),
    ('application/pdf', '.pdf', lambda b: b.startswith(b'%PDF-')),
)


class AttachmentError(ValueError):
    def __init__(self, message):
        self.code = 'attachment-type-mismatch'
        super().__init__(f'{self.code}: {message}')


def read_attachment(path):
    file = Path(path)
    data = file.read_bytes()
    name = file.name
    guessed, encoding = mimetypes.guess_type(name)
    detected = next(((mime, extension) for mime, extension, matches in ATTACHMENT_FORMATS if matches(data[:16])), None)
    if detected:
        mime, extension = detected
        if encoding or guessed not in (None, 'application/octet-stream', mime):
            raise AttachmentError(f'{name}: filename implies {guessed or encoding}, content is {mime}; rename the file to match its content')
        # Keep supplied names and accepted aliases (.jpeg, .tiff); add a suffix only when missing/uninformative.
        if guessed != mime:
            name += extension
    else:
        if not encoding and guessed in {mime for mime, _, _ in ATTACHMENT_FORMATS}:
            raise AttachmentError(f'{name}: content does not match {guessed}; use the original file or correct its filename')
        mime = guessed or 'application/octet-stream'
    return {'name': name, 'mime': mime, 'data': data}


def compose(args, account):
    body = read_body(args)
    if not args.from_addr and not args.reply_to:
        choose_sender(None, None, None)
    parent = None
    if args.reply_to:
        folder, separator, number = args.reply_to.rpartition('/')
        if not separator or not folder:
            raise ValueError('--reply-to needs FOLDER/UID or FOLDER/UIDVALIDITY:UID')
        parse_reference(number)
        parent = parent_headers(folder, number, account)
    owned = account.ownership()
    sender, basis = choose_sender(args.from_addr, parent, owned)
    name = sender_name(args, sender)
    subject = args.subject if args.subject is not None else parent['subject'] if parent else None
    if subject is None or '\n' in subject or '\r' in subject:
        raise ValueError('A single-line subject is required')
    if parent and not subject.lower().startswith('re:'):
        subject = 'Re: ' + subject
    to = args.to if args.to or not parent else reply_recipients(parent, owned)
    envelope = addresses(to + args.cc)
    attachments = [read_attachment(path) for path in args.attach]
    logical = {'sender': sender.lower(), 'fromName': name, 'to': to, 'cc': args.cc,
               'subject': subject, 'body': body, 'parent': parent, 'intent': args.intent_key,
               'attachments': [{'name': a['name'], 'mime': a['mime'], 'hash': hashlib.sha256(a['data']).hexdigest()} for a in attachments]}
    fingerprint = hashlib.sha256(json.dumps(logical, sort_keys=True, ensure_ascii=False).encode()).hexdigest()
    message = EmailMessage(policy=SMTP)
    message['From'] = email.utils.formataddr((name, sender))
    message['To'] = header_addresses(to)
    if args.cc:
        message['Cc'] = header_addresses(args.cc)
    message['Subject'] = subject
    message['Date'] = email.utils.formatdate(localtime=True)
    message['Message-ID'] = email.utils.make_msgid(domain=sender.split('@')[-1])
    if parent and parent['messageId']:
        message['In-Reply-To'] = parent['messageId']
        message['References'] = ' '.join(parent['references'] + [parent['messageId']])
    message.set_content(body)
    for attachment in attachments:
        major, minor = attachment['mime'].split('/', 1)
        message.add_attachment(attachment['data'], maintype=major, subtype=minor, filename=attachment['name'])
    return message, fingerprint, sender, basis, envelope


def receipt_path():
    configured = os.environ.get('PI_MAIL_RECEIPT_DB')
    if configured:
        return Path(configured)
    home = os.environ.get('HOME') or pwd.getpwuid(os.getuid()).pw_dir
    state = os.environ.get('XDG_STATE_HOME') or str(Path(home) / '.local' / 'state')
    return Path(state) / 'pi-stack-next' / 'mail-send' / 'receipts.sqlite3'


class Receipts:
    def __enter__(self):
        path = receipt_path()
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        if path.is_symlink():
            raise ValueError('Receipt database must be an owned regular file')
        descriptor = os.open(path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
        try:
            if os.fstat(descriptor).st_uid != os.getuid():
                raise ValueError('Receipt database belongs to another account')
            os.fchmod(descriptor, 0o600)
        finally:
            os.close(descriptor)
        self.db = sqlite3.connect(path, timeout=5, isolation_level=None)
        self.db.row_factory = sqlite3.Row
        self.db.execute('PRAGMA foreign_keys=ON')
        self.db.execute('PRAGMA journal_mode=WAL')
        self.db.execute('PRAGMA synchronous=FULL')
        if self.db.execute('PRAGMA user_version').fetchone()[0] != 1:
            self.db.execute('BEGIN IMMEDIATE')
            self.db.execute('CREATE TABLE IF NOT EXISTS receipt (id TEXT PRIMARY KEY, fingerprint TEXT NOT NULL, state TEXT NOT NULL, mime BLOB NOT NULL, sender TEXT NOT NULL, recipients TEXT NOT NULL, result TEXT, updated_at INTEGER NOT NULL)')
            self.db.execute("CREATE TABLE IF NOT EXISTS outbound_request (id TEXT PRIMARY KEY REFERENCES receipt(id), writer TEXT NOT NULL, thread TEXT NOT NULL, transition TEXT NOT NULL CHECK(transition IN ('start','continue','supersede','migration')), predecessor TEXT, reason TEXT, recorded_at INTEGER NOT NULL)")
            for column in ('operation_id', 'dispatch_identity'):
                if column not in {row[1] for row in self.db.execute('PRAGMA table_info(outbound_request)')}:
                    self.db.execute(f'ALTER TABLE outbound_request ADD COLUMN {column} TEXT')
            self.db.execute('CREATE TABLE IF NOT EXISTS outbound_fence (recipient TEXT NOT NULL, thread TEXT NOT NULL, request_id TEXT NOT NULL REFERENCES outbound_request(id), PRIMARY KEY(recipient,thread))')
            for row in self.db.execute('SELECT * FROM receipt WHERE id NOT IN (SELECT id FROM outbound_request) ORDER BY updated_at,id').fetchall():
                message = email.message_from_bytes(row['mime'])
                self.claim(row['id'], 'retained:' + row['id'], thread_identity(message),
                           json.loads(row['recipients']), 'migration', None, 'Retained receipt predates writer attribution', row['updated_at'], thread_scopes(message))
            self.db.execute('PRAGMA user_version=1')
            self.db.commit()
        return self

    def __exit__(self, *_):
        self.db.close()

    @contextmanager
    def writer(self, identity, message, recipients):
        """Only overlapping requests/recipient threads exclude each other; never queue SMTP."""
        directory = Path(str(receipt_path()) + '.writers')
        directory.mkdir(mode=0o700, exist_ok=True)
        keys = ['request:' + identity] + ['thread:' + recipient.lower() + ':' + scope
                for recipient in recipients for scope in thread_scopes(message)]
        locks = []
        try:
            for key in sorted(set(keys)):
                descriptor = os.open(directory / hashlib.sha256(key.encode()).hexdigest(),
                                     os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
                locks.append(descriptor)
                try:
                    fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    raise SenderError('send-in-progress', 'This request or recipient/thread is being sent. Inspect the same request later; nothing was resent.')
            yield
        finally:
            for descriptor in reversed(locks):
                os.close(descriptor)

    def get(self, identity):
        return self.db.execute('SELECT * FROM receipt WHERE id=?', (identity,)).fetchone()

    def claim(self, identity, writer, thread, recipients, transition, predecessor, reason, at, scopes=()):
        self.db.execute('INSERT INTO outbound_request (id,writer,thread,transition,predecessor,reason,recorded_at) VALUES(?,?,?,?,?,?,?)',
                        (identity, writer, thread, transition, predecessor, reason, at))
        for scope in set((thread, *scopes)):
            for recipient in recipients:
                self.db.execute('INSERT INTO outbound_fence VALUES(?,?,?) ON CONFLICT(recipient,thread) DO UPDATE SET request_id=excluded.request_id',
                                (recipient.lower(), scope, identity))

    def admit(self, identity, writer, message, recipients, continuing, superseding, reason, inheritable=frozenset()):
        """One writer per thread: a send continues the thread's current heads. Heads written by this writer, or by a writer it
        inherits from (the mail tool names the manager and ended workers on the same goal; pre-attribution `retained:` rows), are
        continued without naming them; any other head needs an explicit supersede with a reason."""
        def inherits(other):
            return other == writer or other in inheritable or other.startswith('retained:')
        thread = thread_identity(message)
        scopes = thread_scopes(message)
        existing = self.db.execute('SELECT * FROM outbound_request WHERE id=?', (identity,)).fetchone()
        if existing is not None:
            if not inherits(existing['writer']):
                return {'ok': False, 'error': 'writer-conflict', 'requestId': identity, 'writer': existing['writer'],
                        'message': f'requestId {identity} belongs to writer {existing["writer"]}, which is still active; use a new requestId for your own message. Nothing was sent.'}
            stale = [dict(row) for recipient in recipients for scope in scopes for row in self.db.execute(
                'SELECT request_id,recipient FROM outbound_fence WHERE recipient=? AND thread=? AND request_id<>?', (recipient, scope, identity))]
            if stale:
                return {'ok': False, 'error': 'request-superseded', 'requestId': identity, 'fences': stale}
            return {'ok': True, 'existing': True}
        heads = [dict(row) for recipient in recipients for scope in scopes for row in self.db.execute(
            'SELECT f.recipient,f.request_id,r.writer,c.state FROM outbound_fence f JOIN outbound_request r ON r.id=f.request_id JOIN receipt c ON c.id=r.id WHERE f.recipient=? AND f.thread=?', (recipient, scope))]
        head_ids = sorted({row['request_id'] for row in heads})
        supplied = continuing or superseding
        predecessors = [supplied] if isinstance(supplied, str) else supplied or []

        def admitted(transition, chosen_reason):
            return {'ok': True, 'existing': False, 'thread': thread, 'transition': transition,
                    'predecessor': predecessor_value(supplied or head_ids) if heads else None, 'reason': chosen_reason, 'scopes': scopes}

        def inherited_reason(rows):
            others = sorted({row['writer'] for row in rows if row['writer'] != writer})
            return 'Writer role inherited from ' + ', '.join(others) + ' (the manager, an ended worker on the same goal, or a pre-attribution receipt)'

        if not supplied:
            if not heads:
                return admitted('start', None)
            if all(row['state'] == 'succeeded' and inherits(row['writer']) for row in heads):
                if all(row['writer'] == writer for row in heads):
                    return admitted('continue', None)
                return admitted('supersede', inherited_reason(heads))
            return fenced(thread, heads, head_ids, inherits)
        if heads and set(head_ids) != set(predecessors):
            return fenced(thread, heads, head_ids, inherits, named=predecessors)
        if not heads:
            return {'ok': False, 'error': 'invalid-predecessor', 'requestIds': predecessors,
                    'message': 'This thread has no earlier request to the same recipients; send without continueAfter/supersede.'}
        priors = []
        for predecessor in predecessors:
            prior = self.db.execute('SELECT r.*,c.state FROM outbound_request r JOIN receipt c ON c.id=r.id WHERE r.id=?', (predecessor,)).fetchone()
            if prior is None:
                return {'ok': False, 'error': 'invalid-predecessor', 'requestId': predecessor}
            if continuing and not inherits(prior['writer']):
                return {'ok': False, 'error': 'writer-conflict', 'requestId': predecessor, 'writer': prior['writer'],
                        'next': {'supersede': head_ids, 'reason': 'REQUIRED: why you take this thread over from that writer'},
                        'message': f'{predecessor} was written by {prior["writer"]}, which is still active (not the manager or an ended worker on your goal). '
                                   f'To take over, pass supersede={json.dumps(head_ids)} and a reason instead of continueAfter. Nothing was sent.'}
            if continuing and prior['state'] != 'succeeded':
                return {'ok': False, 'error': 'predecessor-unsettled', 'requestId': predecessor, 'state': prior['state'],
                        'next': {'supersede': head_ids, 'reason': 'REQUIRED: what inspecting the unsettled request showed and why this message is still right'},
                        'message': 'Retry the retained request after a known failure, or deliberately supersede with a recovery reason.'}
            priors.append(dict(prior))
        if continuing and any(prior['writer'] != writer for prior in priors):
            return admitted('supersede', inherited_reason(priors))
        return admitted('continue' if continuing else 'supersede', reason)

    def save(self, identity, state, result):
        self.db.execute('UPDATE receipt SET state=?,result=?,updated_at=? WHERE id=?',
                        (state, json.dumps(result), int(time.time() * 1000), identity))
        self.db.commit()


def fenced(thread, heads, head_ids, inherits, named=None):
    """thread-fenced, with the exact supersede that would send and why the tool could not decide it alone."""
    live = sorted({row['writer'] for row in heads if not inherits(row['writer'])})
    unsettled = sorted({f"{row['request_id']} ({row['state']})" for row in heads if row['state'] != 'succeeded'})
    why = []
    if named is not None:
        why.append(f'You named {json.dumps(sorted(set(named)))}, but the thread\'s current heads are {json.dumps(head_ids)}: someone sent after the request you named.')
    if live:
        why.append(f'Writer(s) {", ".join(live)} still hold this thread; they are not the manager or an ended worker on your goal.')
    if unsettled:
        why.append(f'Request(s) {", ".join(unsettled)} have no known outcome; inspect them (action=inspect) first so this does not double-send.')
    if not live and not unsettled:
        why.append('Omit continueAfter/supersede to continue these heads, or name them exactly.')
    return {'ok': False, 'error': 'thread-fenced', 'thread': thread, 'fences': heads,
            'next': {'supersede': head_ids, 'reason': 'REQUIRED: why this message should go now despite the above'},
            'message': ' '.join(why) + f' To send anyway pass supersede={json.dumps(head_ids)} with a reason. Nothing was sent.'}


def predecessor_value(value):
    if isinstance(value,list):
        return value[0] if len(value)==1 else json.dumps(sorted(value), separators=(',',':'))
    return value


def thread_scopes(message):
    references = re.findall(r'<[^<>\s]+>', message.get('References', ''))
    parent = re.findall(r'<[^<>\s]+>', message.get('In-Reply-To', ''))
    subject = str(make_header(decode_header(message.get('Subject', ''))))
    subject = re.sub(r'^(?:(?:re|fw|fwd):\s*)+', '', subject.strip(), flags=re.I)
    subject_scope = 'subject:' + ' '.join(subject.casefold().split())
    return ['message:' + (references or parent)[0], subject_scope] if references or parent else [subject_scope]


def thread_identity(message):
    return thread_scopes(message)[0]


def view(row):
    return {'id': row['id'], 'state': row['state'], 'result': json.loads(row['result']) if row['result'] else None,
            'updatedAt': row['updated_at']}


def dispatch(store, row, account):
    identity = row['id']
    connection = None
    entered_data = False
    accepted, rejected = [], []
    phase = 'connect'
    last = time.monotonic()
    timings = {}

    def finished(name):
        nonlocal last
        now = time.monotonic()
        timings[name] = round((now - last) * 1000, 1)
        last = now

    try:
        connection = account.smtp_connection()
        finished('connect')
        phase = 'sender'
        code, _ = connection.mail(row['sender'])
        if code != 250:
            raise smtplib.SMTPSenderRefused(code, b'Sender rejected', row['sender'])
        finished('sender')
        phase = 'recipients'
        for recipient in json.loads(row['recipients']):
            code, _ = connection.rcpt(recipient)
            (accepted if code in (250, 251) else rejected).append(recipient)
        if not accepted:
            raise smtplib.SMTPRecipientsRefused({address: (550, b'Recipient rejected') for address in rejected})
        finished('recipients')
        store.save(identity, 'dispatch-entered', {'acceptedEnvelope': accepted, 'rejected': rejected})
        entered_data = True
        finished('prepareData')
        phase = 'data'
        code, _ = connection.data(row['mime'])
        if code != 250:
            raise smtplib.SMTPDataError(code, b'Message rejected')
        finished('data')
        store.save(identity, 'succeeded', {'timingsMs': timings, 'messageId': email.message_from_bytes(row['mime'])['Message-ID'],
                                         'accepted': accepted, 'rejected': rejected, 'delivery': 'unconfirmed'})
    except Exception as error:
        # Explicit SMTP rejection establishes non-acceptance, including after DATA.
        rejected_by_smtp = isinstance(error, smtplib.SMTPDataError) and 400 <= error.smtp_code < 600
        state = 'uncertain' if entered_data and not rejected_by_smtp else 'failed-before-effect'
        finished(phase)
        detail = {'error': type(error).__name__, 'phase': phase, 'timingsMs': timings,
                  'timedOut': isinstance(error, TimeoutError) or (isinstance(error, smtplib.SMTPServerDisconnected) and 'timed out' in str(error).lower()),
                  'messageId': email.message_from_bytes(row['mime'])['Message-ID'],
                  'acceptedEnvelope': accepted, 'rejected': rejected,
                  'retrySameRequest': state == 'failed-before-effect'}
        if isinstance(error, smtplib.SMTPResponseException):
            detail['smtpCode'] = error.smtp_code
        store.save(identity, state, detail)
    finally:
        if connection:
            try:
                connection.close()
            except Exception:
                try:
                    connection.close()
                except Exception:
                    pass
    if account.sent_copy == 'append' and store.get(identity)['state'] == 'succeeded':
        stored = json.loads(store.get(identity)['result'])
        # SMTP acceptance is the result. Hosted Sent filing runs independently.
        store.save(identity, 'succeeded', {**stored, 'sentCopy': {'state': 'queued'}})
        sent_copy = queue_sent_copy(identity)
        if sent_copy is not None:
            store.save(identity, 'succeeded', {**stored, 'sentCopy': sent_copy})
    result = view(store.get(identity))
    if result['state'] == 'succeeded':
        return {'ok': True, 'value': result}
    return {'ok': False, 'error': 'outcome-uncertain' if result['state'] == 'uncertain' else 'smtp-not-accepted',
            'requestId': identity, 'retrySameRequest': result['state'] == 'failed-before-effect', 'value': result,
            'message': 'Reuse only this requestId after a known pre-DATA failure. If acceptance is uncertain, inspect/recover this request; do not send a replacement.'}


def recover_sent(store, row, account):
    """Only a positive exact Message-ID match establishes success; absence never authorizes resend."""
    identity = row['id']
    message_id = email.message_from_bytes(row['mime'])['Message-ID']
    connection = account.imap_connection()
    try:
        folders = [name for name, flags in listed_folders(connection) if '\\sent' in flags]
        for folder in folders:
            status, _ = connection.select(quote_box(folder), readonly=True)
            if status != 'OK':
                raise ValueError('Cannot select Sent folder')
            validity = uidvalidity(connection)
            status, found = connection.uid('SEARCH', None, 'HEADER', 'Message-ID', '"' + message_id + '"')
            if status != 'OK':
                raise ValueError('Cannot search Sent by Message-ID')
            for uid in (found[0] or b'').decode().split():
                header = fetch_message(connection, uid, validity, 'BODY.PEEK[HEADER.FIELDS (MESSAGE-ID)]')
                if email.message_from_bytes(header)['Message-ID'] != message_id:
                    continue
                previous = json.loads(row['result']) if row['result'] else {}
                store.save(identity, 'succeeded', {**previous, 'messageId': message_id,
                           'accepted': previous.get('acceptedEnvelope', json.loads(row['recipients'])),
                           'rejected': previous.get('rejected', []), 'delivery': 'unconfirmed',
                           'sentReference': folder + '/' + validity + ':' + uid, 'recoveredFromSent': True})
                return {'ok': True, 'value': view(store.get(identity))}
        return {'ok': False, 'error': 'sent-copy-not-found', 'value': view(row),
                'message': 'No exact Message-ID match in Sent. The original outcome remains unchanged; nothing was resent.'}
    finally:
        try:
            connection.logout()
        except Exception:
            pass


def queue_sent_copy(identity):
    """The user service survives the tool's exit and app deployments; no credentials in arguments."""
    unit = 'mail-sent-copy-' + hashlib.sha256(identity.encode()).hexdigest()[:24]
    env = [f'--setenv={name}' for name in ('MAIL_ACCOUNT_FILE', 'PI_MAIL_RECEIPT_DB', 'XDG_STATE_HOME') if name in os.environ]
    try:
        result = subprocess.run(['/usr/bin/systemd-run', '--user', '--quiet', '--collect',
                                 '--property=RuntimeMaxSec=120s', '--unit=' + unit, *env,
                                 '/usr/bin/python3', str(Path(__file__).resolve()), '--append-receipt', identity],
                                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
        if result.returncode:
            return {'state': 'failed', 'error': 'sent-copy-job-not-started'}
    except (OSError, subprocess.TimeoutExpired):
        return {'state': 'unknown', 'error': 'sent-copy-job-start-uncertain'}
    return None


def file_sent_receipt(store, row, account):
    if account.sent_copy != 'append':
        return {'ok': False, 'error': 'sent-copy-provider-managed'}
    if row['state'] != 'succeeded':
        return {'ok': False, 'error': 'smtp-not-accepted', 'value': view(row)}
    stored = json.loads(row['result'])
    if stored.get('sentCopy', {}).get('state') != 'queued':
        return {'ok': True, 'value': view(row)}
    # Claim before IMAP: an interrupted append is not automatically repeated.
    store.save(row['id'], 'succeeded', {**stored, 'sentCopy': {'state': 'appending'}})
    store.save(row['id'], 'succeeded', {**stored, 'sentCopy': append_sent_copy(account, row['mime'])})
    return {'ok': True, 'value': view(store.get(row['id']))}


def append_sent_copy(account, mime):
    """Hosted SMTP does not file outgoing mail; the receipt records whether the Sent copy landed."""
    try:
        connection = account.imap_connection()
    except Exception as error:
        return {'state': 'failed', 'error': type(error).__name__}
    try:
        status, folders = connection.list()
        sent = [line.decode() for line in folders or [] if isinstance(line, bytes) and '\\Sent' in line.decode().split(')')[0]]
        if status != 'OK' or len(sent) != 1:
            return {'state': 'failed', 'error': 'sent-folder-not-unique', 'found': len(sent)}
        name = sent[0].rsplit(' ', 1)[-1]
        status, _ = connection.append(name, '(\\Seen)', imaplib.Time2Internaldate(time.time()), mime)
        return {'state': 'appended', 'folder': name.strip('"')} if status == 'OK' else {'state': 'failed', 'error': 'append-refused'}
    except Exception as error:
        return {'state': 'failed', 'error': type(error).__name__}
    finally:
        try:
            connection.logout()
        except Exception:
            pass


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--to', action='append', default=[])
    parser.add_argument('--cc', action='append', default=[])
    parser.add_argument('--subject')
    parser.add_argument('--body-file')
    parser.add_argument('--stdin-envelope', action='store_true', help='stdin is {"body": TEXT, "inheritWriters": [WRITER_ID]} from the mail tool: the writers whose threads this send may take over')
    parser.add_argument('--from-name', help='From display name for this send; without it the name configured for the sender address (--stdin-envelope senderNames), else sender-name-unconfigured')
    parser.add_argument('--from-addr', help='Sender address; validated against the Proton account. Replies without it use the address of ours the replied-to message reached; anything else is a sender-required error')
    parser.add_argument('--reply-to', metavar='FOLDER/UIDVALIDITY:UID',
                        help='UID from mail-search; bare UID accepted, historical sequence numbers are not UIDs')
    parser.add_argument('--attach', action='append', default=[])
    parser.add_argument('--send', action='store_true')
    parser.add_argument('--canonical-intent', '--intent-key', dest='intent_key')
    parser.add_argument('--request-id', help='Stable identity for this exact message; reuse after a known pre-DATA failure')
    parser.add_argument('--writer-id', help='Owning conversation ID; required for new SMTP dispatch')
    transition = parser.add_mutually_exclusive_group()
    transition.add_argument('--continue-after', metavar='REQUEST_ID', help='Same-writer next message after this successful request')
    transition.add_argument('--supersede', action='append', metavar='REQUEST_ID', help='Deliberate writer takeover or uncertain-effect recovery')
    parser.add_argument('--reason', help='Required evidence/reason for supersession; retained in private ledger')
    parser.add_argument('--append-receipt', help=argparse.SUPPRESS)
    parser.add_argument('--inspect-ledger', action='store_true', help='Inspect private outbound writer/fence history without credentials')
    parser.add_argument('--inspect-action', '--inspect-receipt', dest='inspect_action')
    parser.add_argument('--recover-receipt', help='Find the retained Message-ID in Sent and record a positive match; never resends')
    parser.add_argument('--resume-receipt', help='Send retained MIME only after a known pre-DATA failure/preparation; requires its --writer-id')
    for flag in ('--prior-action', '--prior-revision', '--prior-resolution'):
        parser.add_argument(flag, help='Retained CLI compatibility; local receipts do not require prior contact approval')
    args = parser.parse_args(argv)
    if args.append_receipt:
        with Receipts() as store:
            row = store.get(args.append_receipt)
            result = file_sent_receipt(store, row, load_account()) if row else {'ok': False, 'error': 'request-not-found'}
    elif args.recover_receipt or args.resume_receipt:
        identity = args.recover_receipt or args.resume_receipt
        with Receipts() as store:
            row = store.get(identity)
            if row is None:
                result = {'ok': False, 'error': 'request-not-found', 'requestId': identity}
            else:
                message = email.message_from_bytes(row['mime'])
                recipients = json.loads(row['recipients'])
                with store.writer(identity, message, recipients):
                    row = store.get(identity)
                    if row['state'] == 'succeeded':
                        result = {'ok': True, 'value': view(row), 'replayed': True}
                    elif args.recover_receipt:
                        result = recover_sent(store, row, load_account())
                    elif not args.writer_id:
                        parser.error('--resume-receipt requires --writer-id')
                    elif row['state'] not in ('prepared', 'failed-before-effect'):
                        result = {'ok': False, 'error': 'outcome-uncertain', 'value': view(row),
                                  'message': 'Recover the retained Message-ID from Sent first; nothing was resent.'}
                    else:
                        store.db.execute('BEGIN IMMEDIATE')
                        admission = store.admit(identity, args.writer_id, message, recipients, None, None, None)
                        store.db.commit()
                        result = dispatch(store, row, load_account()) if admission['ok'] else admission
    elif args.inspect_ledger:
        with Receipts() as store:
            result = {'ok': True, 'value': [dict(row) for row in store.db.execute('SELECT r.*,c.state,c.updated_at FROM outbound_request r JOIN receipt c ON c.id=r.id ORDER BY r.recorded_at,r.id')],
                      'fences': [dict(row) for row in store.db.execute('SELECT * FROM outbound_fence ORDER BY thread,recipient')]}
    elif args.inspect_action:
        with Receipts() as store:
            row = store.get(args.inspect_action)
            result = {'ok': row is not None, 'value': view(row) if row else None}
    else:
        if bool(args.body_file) == args.stdin_envelope:
            parser.error('exactly one of --body-file or --stdin-envelope is required unless inspecting a receipt')
        account = load_account()
        message, fingerprint, sender, basis, envelope = compose(args, account)
        print(f"# from: {message['From']} ({basis})", file=sys.stderr)
        if not args.send:
            if args.attach:
                print(f"To: {message['To']}\nCc: {message.get('Cc', '')}\nSubject: {message['Subject']}\n")
                print(read_body(args))
                for part in message.iter_attachments():
                    print(f'# attachment: {part.get_filename()} ({part.get_content_type()}, {len(part.get_payload(decode=True))} bytes)')
            else:
                print(message.as_string())
            print('# not sent (pass --send)', file=sys.stderr)
            return 0
        if not args.request_id or not args.writer_id or not args.writer_id.strip():
            parser.error('--send requires --request-id and --writer-id')
        if args.supersede and (not args.reason or not args.reason.strip()):
            parser.error('--supersede requires --reason explaining continuation/recovery over delay')
        if args.reason and not args.supersede:
            parser.error('--reason requires --supersede')
        identity = args.request_id
        with Receipts() as store, store.writer(identity, message, envelope):
            store.db.execute('BEGIN IMMEDIATE')
            row = store.get(identity)
            if row is not None and row['fingerprint'] != fingerprint:
                result = {'ok': False, 'error': 'identity-conflict', 'requestId': identity, 'message': 'Request identity already belongs to different mail'}
            elif row is not None and row['state'] == 'succeeded':
                result = {'ok': True, 'value': view(row), 'replayed': True}
            elif row is not None and row['state'] in ('dispatch-entered', 'uncertain'):
                result = {'ok': False, 'error': 'outcome-uncertain', 'value': view(row), 'message': 'SMTP acceptance is unknown. Inspect the original message before deciding on a new request; nothing was resent.'}
            else:
                admission = store.admit(identity, args.writer_id, message, envelope, args.continue_after, args.supersede, args.reason, inherit_writers(args))
                if not admission['ok']:
                    result = admission
                elif row is not None and row['state'] not in ('prepared', 'failed-before-effect'):
                    result = {'ok': False, 'error': 'invalid-receipt-state', 'requestId': identity, 'state': row['state']}
                else:
                    if row is None:
                        at = int(time.time() * 1000)
                        store.db.execute('INSERT INTO receipt VALUES(?,?,?,?,?,?,?,?)',
                                         (identity, fingerprint, 'prepared', message.as_bytes(), sender, json.dumps(envelope), None, at))
                        store.claim(identity, args.writer_id, admission['thread'], envelope, admission['transition'], admission['predecessor'], admission['reason'], at, admission['scopes'])
                        store.db.commit()
                        row = store.get(identity)
                    store.db.commit()
                    result = dispatch(store, row, account)
            store.db.commit()
    print(json.dumps(result, ensure_ascii=False))
    return 0 if result['ok'] else 2


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (MailIdentityError, SenderError, AttachmentError) as error:
        print(json.dumps({'ok': False, 'error': error.code, 'message': str(error)}), file=sys.stderr)
        sys.exit(2)
    except ValueError as error:
        # ValueErrors are this tool's own validation messages (never provider text), so the caller sees what to fix.
        print(json.dumps({'ok': False, 'error': 'mail-command-failed', 'failureType': 'ValueError', 'message': str(error)}), file=sys.stderr)
        sys.exit(2)
    except Exception as error:
        # Credential/provider exception strings may contain private server text.
        print(json.dumps({'ok': False, 'error': 'mail-command-failed', 'failureType': type(error).__name__}), file=sys.stderr)
        sys.exit(2)
